{
  "name": "golf-reserv-chatbot",
  "version": "0.1.0",
  "private": true,
  "description": "高爾夫球聚 LINE Chatbot — 群組報名機器人",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run postbuild",
    "postbuild": "node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx scripts/seed-open-event.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@line/bot-sdk": "^9.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.9.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
