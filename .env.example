# LINE Messaging API 憑證（於 LINE Developers Console 取得）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 伺服器埠號
PORT=3000

# 逗號分隔的初始主辦人 LINE userId（可選，MVP 以此設定 host 白名單）
ADMIN_USER_IDS=

# 本機 SQLite 檔路徑（可選，預設 ./data/golf.db；data/ 不進版控）
DATABASE_PATH=./data/golf.db

# 跨試/除錯：設為 1 時於 log 印出每個 webhook 事件的 source（groupId/userId）與文字，
# 方便取得 groupId 以 npm run db:seed 建立測試活動。生產請留空或設 0。
DEBUG_WEBHOOK=
