# LINE Messaging API 憑證（於 LINE Developers Console 取得）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 伺服器埠號（Cloud Run 會以 PORT 注入，預設 8080；本機預設 3000）
PORT=3000

# 逗號分隔的 super-admin LINE userId（可選，D-006 授權模型）。
# 用途：跨群安全網——可救援任何卡住的活動（關閉報名／取消活動）。
# 注意：這是 super-admin，非開團白名單；開團全開（群內任一成員皆可開團），
# close/cancel 授權 = 該活動開團的人（host_user_id）∪ 此 super-admin 清單。
# 空值時無跨群救援能力（除 DB 手術），開團與 close/cancel 由開團的人自理。
# 成員可用「我的ID」查自身 userId 提供給系統管理員加入本清單。
ADMIN_USER_IDS=

# Postgres 連線字串（D-007 PG-only）。
#   * **一律以 ?sslmode=verify-full 結尾**（D-014 G2，資安 H1）：驗憑證鏈 + 驗 hostname。
#     這是唯一在現行 pg 與未來 libpq 語意下意義相同的值；用 require/prefer 會在 pg v9
#     升級時**靜默失去憑證驗證**。程式端不再傳任何 ssl 選項，TLS 全由這個參數決定。
#   * app runtime：Neon **pooled**（host 含 -pooler）字串。
#   * migrate（npm run db:migrate）：Neon **直連**（非 -pooler）字串，一次性部署步驟執行。
#   * 本機測試：見 docker-compose.yml，用 DATABASE_URL_TEST（vitest 讀取；預設 localhost:5433）。
# 一律走環境變數、不進版控（G6）。
DATABASE_URL=

# 本機/CI 測試用 Postgres 連線字串（vitest 讀取；預設見 docker-compose.yml / test/setup-env.ts）。
# 僅本機測試用、非真 secret；prod 一律用上面的 DATABASE_URL。
DATABASE_URL_TEST=postgres://golf:golf@localhost:5433/golf_test

# 跨試/除錯：設為 1 時於 log 印出每個 webhook 事件的 source（groupId/userId）與**訊息全文**，
# 方便取得 groupId 以 npm run db:seed 建立測試活動。
# 資安 M5：NODE_ENV=production 時**程式會無條件忽略本變數**（Dockerfile 已設 production），
# 不再仰賴「生產請關閉」的紀律。本機開發不受影響。
DEBUG_WEBHOOK=
